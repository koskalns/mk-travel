				},
				{
					city: "Alanya",
					country: "Turkey",
					lat: 36.5449,
					lng: 31.9954,
					days: 0,
					spend: 0,
					note: "Add trip details.",
					visitors: ["kristapons"],
				},
				{
					city: "Zagreb",
					country: "Croatia",
					lat: 45.815,
					lng: 15.9819,
					days: 0,
					spend: 0,
					note: "Add trip details.",
					visitors: ["merijons"],
				},
			];
			const countryFlags = {
				austria: "🇦🇹",
				belgium: "🇧🇪",
				china: "🇨🇳",
				croatia: "🇭🇷",
				estonia: "🇪🇪",
				france: "🇫🇷",
				georgia: "🇬🇪",
				germany: "🇩🇪",
				greece: "🇬🇷",
				italy: "🇮🇹",
				latvia: "🇱🇻",
				lithuania: "🇱🇹",
				netherlands: "🇳🇱",
				poland: "🇵🇱",
				portugal: "🇵🇹",
				scotland: "🏴󠁧󠁢󠁳󠁣󠁴󠁿",
				slovenia: "🇸🇮",
				spain: "🇪🇸",
				turkey: "🇹🇷",
				"united kingdom": "🇬🇧",
			};

			const mapEl = document.getElementById("mapViz");
			const statCitiesEl = document.getElementById("statCities");
			const statCountriesEl = document.getElementById("statCountries");
			const statContinentsEl = document.getElementById("statContinents");

			if (!mapEl) {
				throw new Error("Map mount element not found.");
			}

			const normalizeCountry = (value) =>
				value
					.toLowerCase()
					.normalize("NFD")
					.replace(/[\u0300-\u036f]/g, "")
					.replace(/[^a-z\s]/g, "")
					.replace(/\s+/g, " ")
					.trim();

			const countryAliases = {
				england: "united kingdom",
			};

			const countryToContinent = {
				austria: "Europe",
				belgium: "Europe",
				china: "Asia",
				croatia: "Europe",
				estonia: "Europe",
				france: "Europe",
				georgia: "Asia",
				germany: "Europe",
				greece: "Europe",
				italy: "Europe",
				latvia: "Europe",
				lithuania: "Europe",
				netherlands: "Europe",
				poland: "Europe",
				portugal: "Europe",
				scotland: "Europe",
				slovenia: "Europe",
				spain: "Europe",
				turkey: "Asia",
				"united kingdom": "Europe",
			};

			const normalizedCountries = trips.map((trip) => {
				const normalized = normalizeCountry(trip.country);
				return countryAliases[normalized] ?? normalized;
			});
			const uniqueCountryCount = new Set(normalizedCountries).size;
			const continentsVisited = new Set(
				normalizedCountries
					.map((country) => countryToContinent[country])
					.filter(Boolean),
			);

			const countryFrequency = new Map();
			for (const country of normalizedCountries) {
				countryFrequency.set(country, (countryFrequency.get(country) ?? 0) + 1);
			}

			let topCountry = "-";
			let topCountryCount = 0;
			for (const [country, count] of countryFrequency.entries()) {
				if (count > topCountryCount) {
					topCountry = country;
					topCountryCount = count;
				}
			}

			if (statCitiesEl) statCitiesEl.textContent = String(trips.length);
			if (statCountriesEl) statCountriesEl.textContent = String(uniqueCountryCount);
			if (statContinentsEl) statContinentsEl.textContent = String(continentsVisited.size);

			const sortedCountries = [...countryFrequency.entries()].sort((a, b) => b[1] - a[1]);

			const countriesListEl = document.getElementById("statCountriesList");
			if (countriesListEl) {
				countriesListEl.innerHTML = sortedCountries.map(([country]) => {
					const displayName = country.replace(/\b\w/g, (c) => c.toUpperCase());
					const flag = countryFlags[country] ?? "🌍";
					return `<span class="country-chip">${flag} ${displayName}</span>`;
				}).join("");
			}

			try {
				const pigPinIcon = L.icon({
					iconUrl: "/pig-pin.svg",
					iconSize: [34, 34],
					iconAnchor: [17, 30],
					popupAnchor: [0, -24],
				});

				const bluePinIcon = L.icon({
					iconUrl: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 40'%3E%3Cpath d='M16 2c-7.7 0-14 6.3-14 14 0 7.7 14 22 14 22s14-14.3 14-22c0-7.7-6.3-14-14-14z' fill='%235b8fd4' /%3E%3Ccircle cx='16' cy='16' r='5' fill='white'/%3E%3C/svg%3E",
					iconSize: [34, 34],
					iconAnchor: [17, 30],
					popupAnchor: [0, -24],
				});

				const redPinIcon = L.icon({
					iconUrl: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 40'%3E%3Cpath d='M16 2c-7.7 0-14 6.3-14 14 0 7.7 14 22 14 22s14-14.3 14-22c0-7.7-6.3-14-14-14z' fill='%23d45b5b' /%3E%3Ccircle cx='16' cy='16' r='5' fill='white'/%3E%3C/svg%3E",
					iconSize: [34, 34],
					iconAnchor: [17, 30],
					popupAnchor: [0, -24],
				});

				const map = L.map(mapEl, {
					worldCopyJump: true,
					minZoom: 2,
					maxZoom: 8,
					zoomSnap: 0.25,
					zoomDelta: 0.75,
					wheelPxPerZoomLevel: 28,
				});

				L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
					attribution:
						'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; CARTO',
					subdomains: "abcd",
				}).addTo(map);

				const territoryDenylist = new Set([
					"french guiana",
					"guiana",
					"guyane",
					"guyane francaise",
					"guyana",
					"guadeloupe",
					"martinique",
					"reunion",
					"mayotte",
					"falkland islands",
					"falkland",
					"malvinas",
					"curacao",
					"sint maarten",
					"aruba",
					"bonaire",
					"eustatius",
					"saba",
					"saint barthelemy",
					"saint martin",
					"st barthelemy",
					"st martin",
					"turks and caicos",
					"british virgin islands",
					"virgin islands",
					"puerto rico",
					"us virgin islands",
					"us virgin",
					"greenland",
					"aland islands",
					"faroe islands",
					"new caledonia",
					"french polynesia",
					"samoa",
					"american samoa",
					"guam",
					"northern mariana",
					"hong kong",
					"macao",
					"macau",
				]);

				const pinnedCountries = new Set(
					trips.map((trip) => {
						const normalized = normalizeCountry(trip.country);
						return countryAliases[normalized] ?? normalized;
					}),
				);

				const countryVisitors = new Map();
				for (const trip of trips) {
					const normalized = normalizeCountry(trip.country);
					const country = countryAliases[normalized] ?? normalized;
					if (!countryVisitors.has(country)) {
						countryVisitors.set(country, []);
					}
					if (trip.visitors) {
						countryVisitors.get(country).push(...trip.visitors);
					}
				}

				map.createPane("countryHighlight");
				map.getPane("countryHighlight").style.zIndex = "360";
				map.getPane("countryHighlight").style.pointerEvents = "none";

				const countryGeoJsonUrl =
					"https://raw.githubusercontent.com/datasets/geo-countries/master/data/countries.geojson";
				const response = await fetch(countryGeoJsonUrl);
				if (response.ok) {
					const world = await response.json();
					L.geoJSON(world, {
						pane: "countryHighlight",
						style: (feature) => {
							const props = feature?.properties ?? {};

							// First check: if the place's actual NAME is a territory, always exclude it
							const featureName = normalizeCountry(props.NAME || props.name || "");
							if (territoryDenylist.has(featureName)) {
								return {
									color: "transparent",
									weight: 0,
									fillColor: "transparent",
									fillOpacity: 0,
								};
							}

							// Check if it's a pinned country and get visitor info
							const isPinnedCountry = pinnedCountries.has(featureName);
							if (!isPinnedCountry) {
								return {
									color: "transparent",
									weight: 0,
									fillColor: "transparent",
									fillOpacity: 0,
								};
							}

							const visitors = countryVisitors.get(featureName) ?? [];
							const hasKristapons = visitors.includes("kristapons");
							const hasMerijons = visitors.includes("merijons");

							let borderColor = "#f4bfd5";
							let fillColor = "#f8d5e5";

							if (hasKristapons && !hasMerijons) {
								borderColor = "#5b8fd4";
								fillColor = "#a3c5ea";
							} else if (hasMerijons && !hasKristapons) {
								borderColor = "#d45b5b";
								fillColor = "#ea9b9b";
							}

							return {
								color: borderColor,
								weight: 1,
								fillColor: fillColor,
								fillOpacity: 0.35,
							};
						},
					}).addTo(map);
				}

				const bounds = [];
				for (const trip of trips) {
					const isKristaponsOnly = trip.visitors && trip.visitors.includes("kristapons") && trip.visitors.length === 1;
					const isMerijonsOnly = trip.visitors && trip.visitors.includes("merijons") && trip.visitors.length === 1;

					let icon = pigPinIcon;
					let mark = "";
					if (isKristaponsOnly) {
						icon = bluePinIcon;
						mark = " ★";
					} else if (isMerijonsOnly) {
						icon = redPinIcon;
						mark = " ◆";
					}

					const marker = L.marker([trip.lat, trip.lng], {
						icon: icon,
					}).addTo(map);

					marker.bindPopup(
						`<b>${trip.city}, ${trip.country}</b>${mark}`,
					);

					bounds.push([trip.lat, trip.lng]);
				}

				if (bounds.length > 0) {
					map.fitBounds(bounds, {
						padding: [45, 45],
						maxZoom: 3.75,
					});
				}

				window.addEventListener("resize", () => map.invalidateSize());
			} catch (error) {
				console.error("Failed to initialize map", error);
				mapEl.innerHTML =
					"<p style='padding:1rem;color:#3f4e3e'>Could not load map. Please refresh or check your network connection.</p>";
			}
		</script>
	</body>
</html>

