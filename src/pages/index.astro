		--card: rgba(255, 247, 224, 0.92);
		--retro-frame: #6f4c20;
		--retro-frame-dark: #4b3316;
		--pixel-aqua: #d8bf8a;
		--pixel-peach: #e0b15c;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
